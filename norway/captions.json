[{"s": 0.0, "e": 1.4, "t": "Норвегия и Австралия"}, {"s": 1.4, "e": 2.7, "t": "разбогатели на продаже"}, {"s": 2.7, "e": 3.18, "t": "газа."}, {"s": 3.52, "e": 4.64, "t": "Норвегия превратила"}, {"s": 4.64, "e": 5.46, "t": "это в фонд на"}, {"s": 5.46, "e": 6.7, "t": "2 триллиона долларов."}, {"s": 7.08, "e": 8.42, "t": "А Австралия почти всё"}, {"s": 8.42, "e": 8.87, "t": "раздала."}, {"s": 9.3, "e": 10.08, "t": "Сейчас объясним."}, {"s": 10.48, "e": 11.46, "t": "Норвегия решила,"}, {"s": 11.76, "e": 12.7, "t": "что доходы от газа"}, {"s": 12.7, "e": 13.6, "t": "принадлежат всем."}, {"s": 14.04, "e": 15.32, "t": "Поэтому газовые компании"}, {"s": 15.32, "e": 17.48, "t": "платят налог до 78%."}, {"s": 17.76, "e": 18.94, "t": "И почти всё это"}, {"s": 18.94, "e": 20.3, "t": "идёт в один гигантский"}, {"s": 20.3, "e": 20.75, "t": "фонд."}, {"s": 21.06, "e": 22.42, "t": "Деньги вложили и фонд"}, {"s": 22.42, "e": 23.28, "t": "продолжал расти."}, {"s": 23.66, "e": 24.88, "t": "Теперь каждый год он"}, {"s": 24.88, "e": 26.04, "t": "оплачивает около 60"}, {"s": 26.04, "e": 27.24, "t": "миллиардов долларов"}, {"s": 27.24, "e": 28.06, "t": "на больницы,"}, {"s": 28.28, "e": 29.32, "t": "школы и дороги."}, {"s": 29.32, "e": 30.62, "t": "А сам фонд всё"}, {"s": 30.62, "e": 31.32, "t": "равно растёт."}, {"s": 31.7, "e": 32.92, "t": "Австралия пошла другим"}, {"s": 32.92, "e": 33.370000000000005, "t": "путём."}, {"s": 33.6, "e": 34.84, "t": "Она продаёт миру газа"}, {"s": 34.84, "e": 35.92, "t": "больше чем на 50"}, {"s": 35.92, "e": 36.94, "t": "миллиардов долларов"}, {"s": 36.94, "e": 37.4, "t": "в год."}, {"s": 37.78, "e": 38.230000000000004, "t": "А налог,"}, {"s": 38.34, "e": 39.18, "t": "который должен давать"}, {"s": 39.18, "e": 40.24, "t": "австралийцам долю этой"}, {"s": 40.24, "e": 40.690000000000005, "t": "прибыли?"}, {"s": 41.0, "e": 42.2, "t": "Примерно 3 цента с"}, {"s": 42.2, "e": 43.04, "t": "каждого доллара."}, {"s": 43.38, "e": 44.42, "t": "И вот самое худшее."}, {"s": 44.88, "e": 46.38, "t": "Годами гигантские газовые"}, {"s": 46.38, "e": 47.6, "t": "заводы на экспорт не"}, {"s": 47.6, "e": 48.78, "t": "платили его вообще."}, {"s": 49.16, "e": 51.22, "t": "Ни цента — до 2024"}, {"s": 51.22, "e": 52.14, "t": "года."}, {"s": 52.54, "e": 53.22, "t": "Две страны,"}, {"s": 53.54, "e": 54.28, "t": "один и тот же"}, {"s": 54.28, "e": 54.730000000000004, "t": "газ."}, {"s": 54.9, "e": 56.24, "t": "Норвегия оставила деньги"}, {"s": 56.24, "e": 56.690000000000005, "t": "себе,"}, {"s": 57.06, "e": 58.32, "t": "а Австралия дала им"}, {"s": 58.32, "e": 58.77, "t": "уплыть."}, {"s": 59.13, "e": 59.580000000000005, "t": "Кстати,"}, {"s": 59.72, "e": 60.76, "t": "такие вопросы часто"}, {"s": 60.76, "e": 62.18, "t": "попадаются на ЕНТ по"}, {"s": 62.18, "e": 62.8, "t": "географии."}, {"s": 63.12, "e": 64.14, "t": "Мы подготовили гайд"}, {"s": 64.14, "e": 65.48, "t": "по географии для ЕНТ."}, {"s": 65.82, "e": 66.98, "t": "Если хочешь его получить,"}, {"s": 67.42, "e": 68.28, "t": "напиши в комментариях"}, {"s": 68.28, "e": 69.46, "t": "слово «гео»."}]